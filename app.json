{
  "expo": {
    "name": "fristaid-mobile",
    "slug": "fristaid-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "fristaidmobile",
      "com.googleusercontent.apps.1088041004112-p9n4ckupmdoti1olnum28du96ioruqdm"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.africasecours.fristaidmobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AfricaSecours a besoin d'accéder à votre position uniquement lorsque vous choisissez de la partager en cas d'urgence.",
          "locationWhenInUsePermission": "AfricaSecours a besoin d'accéder à votre position uniquement lorsque vous choisissez de la partager en cas d'urgence.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AfricaSecours a besoin d'accéder à vos photos pour définir votre photo de profil."
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "AfricaSecours a besoin d'accéder à vos photos pour enregistrer votre carte d'identité.",
          "savePhotosPermission": "AfricaSecours a besoin d'enregistrer votre carte d'identité dans vos photos."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "africasecour",
          "project": "fristaid-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00979568-c40b-4831-8f3d-0a7a9dadf96d"
      }
    },
    "owner": "boubaphoenix"
  }
}
