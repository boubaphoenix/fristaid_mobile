# Config Apache pour l'hébergement de la PWA AfricaSecours sur Hostinger
# (app.africasecour.com). Copié tel quel dans dist/ au build (voir
# scripts/build-sw.mjs) — ne pas éditer dans dist/, éditer ici.

# --- 1. Forcer HTTPS ---------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 2. Redirection SPA --------------------------------------------------
# Expo génère un fichier HTML par page connue au moment du build, mais une
# page avec un identifiant réel dans l'URL (ex: une leçon précise) n'a pas
# de fichier correspondant : on renvoie index.html dans ce cas, et c'est le
# JavaScript de l'app qui lit l'URL et affiche la bonne page (même principe
# que le service worker en mode hors-ligne, voir src/sw/sw-src.ts).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# --- 3. Cache : jamais sur ce qui doit rester à jour ---------------------
# sw.js et manifest.json doivent être revérifiés à chaque visite, sinon le
# navigateur ne verra jamais les mises à jour de l'app.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- 4. Cache long sur le JS/CSS/images compilés -----------------------
  # Leur nom de fichier change automatiquement dès que leur contenu change
  # (ex: icon.3210bd5c....png), donc on peut les garder en cache 1 an sans
  # risque de servir une ancienne version par erreur.
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- 5. En-têtes de sécurité (miroir de helmet côté backend) -----------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP : React Native Web injecte ses styles via des balises <style>
  # (voir dist/index.html), d'où 'unsafe-inline' sur style-src uniquement —
  # script-src reste strict, sans 'unsafe-inline' ni 'unsafe-eval'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://res.cloudinary.com; font-src 'self' data:; connect-src 'self' https://api.africasecour.com https://*.sentry.io; frame-src https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- 6. Compression --------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
